-- ==================== VIEWS COM TRATAMENTO DE NULL ====================

-- vw_olist_orders
CREATE VIEW vw_olist_orders AS
SELECT
    order_id,
    customer_id,
    ISNULL(order_status, 'desconhecido') AS order_status,
    ISNULL(order_purchase_timestamp, '1900-01-01') AS order_purchase_timestamp,
    ISNULL(order_approved_at, '1900-01-01') AS order_approved_at,
    ISNULL(order_delivered_carrier_date, '1900-01-01') AS order_delivered_carrier_date,
    ISNULL(order_delivered_customer_date, '1900-01-01') AS order_delivered_customer_date,
    ISNULL(order_estimated_delivery_date, '1900-01-01') AS order_estimated_delivery_date
FROM olist_orders_dataset;
GO

-- vw_olist_order_items
CREATE VIEW vw_olist_order_items AS
SELECT
    order_id,
    order_item_id,
    product_id,
    seller_id,
    ISNULL(shipping_limit_date, '1900-01-01') AS shipping_limit_date,
    ISNULL(price, 0) AS price,
    ISNULL(freight_value, 0) AS freight_value
FROM olist_order_items_dataset;
GO

-- vw_olist_reviews
CREATE VIEW vw_olist_reviews AS
SELECT
    order_id,
    ISNULL(review_score, 0) AS review_score,
    ISNULL(review_comment_title, 'sem título') AS review_comment_title,
    ISNULL(review_comment_message, 'sem comentário') AS review_comment_message,
    ISNULL(review_creation_date, '1900-01-01') AS review_creation_date,
    ISNULL(review_answer_timestamp, '1900-01-01') AS review_answer_timestamp
FROM olist_order_reviews_dataset;
GO

-- vw_olist_payments
CREATE VIEW vw_olist_payments AS
